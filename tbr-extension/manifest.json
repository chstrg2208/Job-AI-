{
  "manifest_version": 3,
  "name": "TBR SOP AI Assistant - Team Tiger Truong",
  "version": "3.8.0",
  "description": "Trợ lý AI hướng dẫn 35 quy trình vận hành nội bộ (SOP) chuẩn hóa, dẫn nguồn minh bạch cho The Best Rate Insurance.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

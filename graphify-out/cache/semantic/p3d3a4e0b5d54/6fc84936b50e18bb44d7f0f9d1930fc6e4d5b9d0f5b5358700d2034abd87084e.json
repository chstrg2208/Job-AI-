{"nodes": [{"id": "quy_tr\u00ecnh_1099presidio_tiger_presidio_1099_tiger_guide", "label": "1099 Presidio Healthcare (The FortressPlan) Operational Guide", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 1-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_presidio_healthcare", "label": "Presidio Healthcare (Texas-Based Christian/Pro-life Regulated Health Insurer, TDI)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 2, 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positions Presidio as 100% state-regulated health insurance rather than loose Healthcare Sharing, appealing to healthy 1099 self-employed/freelance/independent contractor clients."}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_fortress_plan_core", "label": "Fortress Plan (Mandatory Core Plan: $0 Deductible, 50/50 Simple Coinsurance, MOOP, Unlimited Lifetime, Balance Rollover)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes traditional upfront deductibles by sharing every covered bill 50/50 from dollar one until MOOP is reached (then 100% covered) and rolling over unused MOOP balance (<50%) to lower renewal premiums."}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_four_plan_options_moop", "label": "4 Plan Options: Elite ($2.5k/$5k), Secure ($5k/$10k), Value ($7.5k/$15k), Essential ($10k/$20k MOOP)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "page 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_wellness_plan_addon", "label": "Wellness Plan (Optional Preventive Care / Screening / Vaccination Add-on)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_presidio_tx_enrollment_checklist", "label": "Presidio TX Enrollment Checklist (TX Only, Nationwide Doctors, No Consent, SSN + Green Card, Day 19 Cutoff, ACH Avoids 3.5% CC Fee)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Day 19 cutoff secures 1st-of-next-month effective date, while Bank Account (ACH) avoids the 3.5% Credit Card surcharge; debit and Member ID emails arrive in 3-5 days."}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_first_health_ppo_network", "label": "First Health PPO Network (>1M Providers, Aetna/CVS Health Subsidiary, In-Network Discount, firsthealthlbp.com)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 3-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives Presidio nationwide PPO access with negotiated in-network discounts before 50/50 coinsurance; members should ask providers if they accept First Health PPO Network rather than Presidio."}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_presidio_member_portal_and_virtual_care", "label": "Presidio Member Portal (my.presidiocare.com, Group PH001, Billing/EOB/Live Upload/Chat) & 24/7 Virtual Care ((855) 954-9001)", "file_type": "paper", "source_file": "Quy Tr\u00ecnh/1099Presidio - Tiger.pdf", "source_location": "pages 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quy_tr\u00ecnh_1099presidio_tiger_shield_pbm_rxvalet", "label": "SHIELD PBM / RxValet Pharmacy Portal (shieldpbm.com, RxBIN 026556, Delivery/Transferable, Pet Rx, Prior Auth, Fax 888-87
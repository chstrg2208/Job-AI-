s."}], "edges": [{"source": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_obamacare_plan_advisory_guide", "target": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_client_need_group1_preventive", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Quy Tr\u00ecnh/H\u01b0\u1edbng D\u1eabn T\u01b0 V\u1ea5n Ch\u1ecdn Plan Obamacare & Ch\u0103m S\u00f3c Kh\u00e1ch H\u00e0ng D\u00e0nh Cho Agent.pdf", "source_location": "Pages 1, 3", "weight": 1.0}, {"source": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_obamacare_plan_advisory_guide", "target": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_client_need_group2_immediate_care", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Quy Tr\u00ecnh/H\u01b0\u1edbng D\u1eabn T\u01b0 V\u1ea5n Ch\u1ecdn Plan Obamacare & Ch\u0103m S\u00f3c Kh\u00e1ch H\u00e0ng D\u00e0nh Cho Agent.pdf", "source_location": "Pages 1-3", "weight": 1.0}, {"source": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_obamacare_plan_advisory_guide", "target": "quy_tr\u00ecnh_h\u01b0\u1edbng_d\u1eabn_t\u01b0_v\u1ea5n_ch\u1ecdn_plan_obamacare_ch\u0103m_s\u00f3c_kh\u00e1ch_h\u00e0ng_d\u00e0nh_cho_agent_client_need_group3_chronic_regular", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Quy Tr\u00ecnh/H\u01b0\u1edbng D\u1eabn T\u01b0 V\u1ea5n Ch\u1ecdn Plan Obamacare & Ch\u0103m S\u00f3c Kh\u00e1ch H\u00e0ng D\u00e0nh Cho Agent.pdf", "source_location": "Pages 2-3", 
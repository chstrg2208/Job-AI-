pe": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_thuy_phan", "label": "Thuy Phan (Board Attendee)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_hr_ruby", "label": "HR Ruby", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_agent_support_split_policy", "label": "Agent vs Support Responsibility & Commission Split (70/30 vs 50/50)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 7-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renewals (all agents) and new clients of New Agents stay 70% Agent - 30% Support (CRM SSS NONE Split 0.7) to train and retain new agents; Senior Agents (6-12+ months) must self-handle A-Z for 70% (SSS NONE) or delegate to Support at 50-50 (SSS PARTIAL Split 0.5)."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_bluehost_ban_policy", "label": "Bluehost Client Email Ban (@ushins.com, @tbri.co) & Gmail Standardization", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 14-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMS auto-scans shared broker domains like @ushins.com and @tbri.co, locks applications, and permanently revokes Agent NPNs; require client Gmail/personal email recorded with password in CRM, leaving Bluehost read-only for unmigrated legacy accounts."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_agent_email_migration", "label": "Agent Email Migration (@thebestrateins.com to @tbr-agent.com)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 19-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saves $7,200/yr Google Workspace cost ($12/user/mo x 50 users = $600/mo); migrate Inactive & New Agents immediately to Webmail @tbr-agent.com, keep Active Agents on legacy email until Feb 2027 post-OEP carrier contract batch update, while RingCentral preserves 100% messages via Account ID."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_idme_mismatch_fix", "label": "ID.me Mismatch Fix (Character-for-Character Healthcare.gov Match)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authorizations failing immediately after ID.me success are caused by mismatched name/DOB/address characters between Healthcare.gov and verified ID.me records."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_bar_15_12_duplicate_trap", "label": "BAR Dec 15 Duplicate Application Trap (Claim 2026 App Rule)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submitting a standalone 2027 New Application without claiming the 2026 app causes CMS Batch Auto Re-enrollment (BAR) on Dec 15 to auto-renew 2026 under the old NPN, triggering a duplicate SSN cancellation in January."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_auto_renew_button_trap", "label": "Auto-Renew Button Trap vs Update Application Agent Help Flow", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clicking Keep 2026 plan/Auto-renew preserves the prior agent NPN ($0 commission); Support/Agent must use Update Application for 2027 and replace the Agent or Broker Help NPN before submitting."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_ffm_pull_app_skills", "label": "FFM Application Recovery Skills (Household Head Swap, View-Only Trick, 3-Way Call 1-800-318-2596)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 32-34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_ambetter_top1_strategy", "label": "2027 Carrier Strategy TOP 1: Ambetter Health (Gold $0, Kelsey-Seybold)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$25/member payrate plus highest 2027 bonus; covers Memorial Hermann, Houston Methodist, Texas Children's, and breaks the prior Kelsey-Seybold carrier monopoly at lower premium."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_oscar_top2_strategy", "label": "2027 Carrier Strategy TOP 2: Oscar (Cap 5 Members, Silver/Gold $0)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "line 39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$25/member (capped at 5 members/policy) plus seasonal bonuses; serves as primary Memorial Hermann backup carrier when Ambetter does not fit."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_fallback_and_drop_carriers", "label": "TOP 3 Aetna/BCBS Fallback & High-Risk Carrier Elimination", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 40-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid UHC and zero-commission Molina states due to cancel-backs, commission blocks, and complex NPN rules."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_it_audit_and_crm_compliance", "label": "Contract RTS Discipline, CRM Daily Data Entry & Weekly Monday IT Audit", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 45-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enrolling without an Active/RTS state contract results in $0 commission liability; Monday IT audit cross-checks HR active contracts vs CRM deals and flags mismatches within 24-48 hours."}, {"id": "graphify_out_converted_bien_ban_hop_bql_30_10_2026_tiger_truong_b6b097e7_urgent_fl_blue_case", "label": "Urgent Florida Blue Case: Hai Do (D26005815, Exp 31/10/2026)", "file_type": "concept", "source_file": "graphify-out/converted/Bien_Ban_Hop_BQL_30_10_2026_Tiger_Truong_b6b097e7.md", "source_location": "lines 52-57", "source_url": null, "captured_at": null,